#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER 1
#define NUM 2
#define CONTROL 3
#define MEH LS(LA(LCTL))
#define HYPER LS(LA(LC(LGUI)))


/ {
    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_RCTL|MOD_RSFT)>;
            keep-mods = <(MOD_LCTL|MOD_RSFT)>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
// ------------------------------------------------------------------------------------------------------------
// |  ESC       |  1   |  2   |  3     |  4      |  5   |     |  6     |  7       |  8      |  9    |   0    |   -      |
// |  TAB       |  Q   |  W   |  E     |  R      |  T   |     |  Y     |  U       |  I      |  O    |   P    | BSPC-DEL |
// | LSHFT      |  A   |  S   |  D     |  F      |  G   |     |  H     |  J       |  K      |  L    |   ;    |  RSHFT   |
// | lCTRL      |  Z   |  X   |  C     |  V      |  B   |     |  N     |  M       |  ,      |  .    |   /    |  RCTRL   |
//                            | ALT    | SPACE   | LOWER|     | RAISE  | ENTER    | RCTRL   |
            bindings = <
&kp ESC          &kp N1           &kp N2           &kp N3            &kp N4          &kp N5                      &kp N6         &kp N7          &kp N8         &kp N9        &kp N0          &kp MINUS
&kp TAB          &kp Q            &kp W            &kp E             &kp R           &kp T                       &kp Y          &kp U           &kp I          &kp O         &kp P           &bspc_del
&mt LSHFT CAPS   &kp A            &kp S            &kp D             &kp F           &kp G                       &kp H          &kp J           &kp K          &kp L         &kp SEMI        &kp RSHFT
&kp LCTRL        &kp Z            &kp X            &kp C             &kp V           &kp B                       &kp N          &kp M           &kp COMMA      &kp DOT       &kp FSLH        &kp RCTRL
                                                   &lt CONTROL ESC   &mt MEH SPACE   &lt LOWER ENTER             &mo NUM        &mt MEH SPACE   &kp RETURN
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
// ------------------------------------------------------------------------------------------------------------
// |  F1      |  F2 |  F3 |  F4  |  F5  |  F6  |     |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// | BTCLRALL | BT1 | BT2 |  BT3 |  BT4 |  BT5 |     |      |       |       |      |       |       |
// |   `      |  !  |  @  |  #   |  $   |  %   |     |  ^   |  &    |  *    |  (   |   )   |   ~   |
// |          |     |     |      |      |      |     |      |  _    |  +    |  {   |   }   |  "|"  |
//                        |      |      |      |     |      |       |       |
            bindings = <
&kp F1          &kp F2           &kp F3            &kp F4            &kp F5       &kp F6                      &kp F7        &kp F8          &kp F9          &kp F10      &kp F11         &kp F12
&kp F1          &kp F2           &kp F3            &kp F4            &kp F5       &kp F6                      &kp F7        &kp F8          &kp F9          &kp F10      &kp F11         &kp F12
&bt BT_CLR_ALL  &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &to NUM      &bt BT_SEL 4                &trans        &trans          &trans          &trans       &trans          &trans
&studio_unlock  &trans           &trans            &trans            &trans       &trans                      &trans        &kp MINUS       &kp PLUS        &kp LBRC     &kp RBRC        &kp PIPE
                                                   &trans            &trans       &trans                      &trans        &trans          &trans
            >;
        };

        num_layer {
            display-name = "Num Layer";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |     |      |       |       |      |       |       |
// |   `   |  1  |  2  |  3   |  4   |  5   |     |  6   |   7   |   8   |  9   |   0   |       |
// |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |     |      |   <-  |   v   |  ^   |  ->   |       |
// |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |     |  +   |   -   |   =   |  [   |   ]   |   \   |
//                     |      |      |      |     |      |       |       |
            bindings = <
&kp ESC          &kp F2          &kp KP_NUMLOCK    &kp KP_DIVIDE    &kp KP_MULTIPLY &kp KP_MINUS                &trans        &trans           &trans          &trans       &trans          &bootloader
&kp TAB          &kp LC(C)       &kp KP_N7         &kp KP_N8        &kp KP_N9       &kp KP_PLUS                 &kp N6        &kp N7           &kp UP          &kp N9       &kp N0          &trans
&mt LSHFT CAPS   &kp LC(V)       &kp KP_N4         &kp KP_N5        &kp KP_N6       &kp KP_N0                   &trans        &kp LEFT         &kp DOWN        &kp RIGHT    &kp RIGHT       &trans
&kp LCTRL        &kp LC(X)       &kp KP_N1         &kp KP_N2        &kp KP_N3       &kp KP_DOT                  &kp KP_PLUS   &kp MINUS        &kp EQUAL       &kp LBKT     &kp RBKT        &kp BSLH
                                                   &to DEFAULT      &kp KP_ENTER    &kp EQUAL                   &trans        &mt HYPER SPACE  &trans
            >;
        };

        control_layer {
            display-name = "Control Layer";
// ------------------------------------------------------------------------------------------------------------
// |  F1      |  F2 |  F3 |  F4  |  F5  |  F6  |     |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// | BTCLRALL | BT1 | BT2 |  BT3 |  BT4 |  BT5 |     |      |       |       |      |       |       |
// |   `      |  !  |  @  |  #   |  $   |  %   |     |  ^   |  &    |  *    |  (   |   )   |   ~   |
// |          |     |     |      |      |      |     |      |  _    |  +    |  {   |   }   |  "|"  |
//                        |      |      |      |     |      |       |       |
            bindings = <
&bt BT_CLR_ALL  &kp F2           &kp F3            &kp F4            &kp F5       &kp F6          &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&kp F1          &kp F2           &kp F3            &kp F4            &kp F5       &kp F6          &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&bt BT_CLR      &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4    &trans    &trans    &trans    &trans    &trans    &trans
&bt BT_CLR      &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4    &trans    &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE
                                                   &trans            &trans       &trans          &trans    &trans    &trans
            >;
        };

        extra2 {
            status = "reserved";
        };

    };
};